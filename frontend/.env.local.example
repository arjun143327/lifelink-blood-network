# LifeLink Frontend Environment Variables

# Backend API URL (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Default to Mock API mode for zero-setup demo & evaluation
# Set to 'false' to connect directly to the running FastAPI backend
NEXT_PUBLIC_USE_MOCK=true

# Optional: Mapbox GL Access Token (fallback to Leaflet OpenStreetMap if not provided)
NEXT_PUBLIC_MAPBOX_TOKEN=
